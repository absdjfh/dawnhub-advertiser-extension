    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.5.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.8.3",
    "publish-browser-extension": "5.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
