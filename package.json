{
  "name": "dawnhub-advertiser-extension",
  "description": "Tools for Dawnhub advertisers on the Dawnhub raids and bookings pages.",
  "private": true,
  "version": "26.9.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
